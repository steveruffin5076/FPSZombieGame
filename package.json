{
  "name": "deadlight",
  "version": "1.0.0",
  "private": true,
  "description": "DEADLIGHT - a realistic first-person zombie survival shooter for the browser (L4D-inspired), with AI teammates, an AI Director, special infected and a 5-chapter campaign.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "check:levels": "esbuild src/tools/HeadlessLevels.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/levels.mjs --alias:@=./src --log-level=warning && node node_modules/.cache/levels.mjs",
    "sim": "esbuild src/tools/HeadlessSim.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim.mjs --alias:@=./src --log-level=warning && node node_modules/.cache/sim.mjs"
  },
  "keywords": [
    "three.js",
    "webgl",
    "fps",
    "zombie",
    "game",
    "webgl2",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "esbuild": "^0.28.2"
  }
}
